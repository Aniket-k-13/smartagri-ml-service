# Copy to .env.local and adjust as needed.

# Real Django backend (already live: accounts/register, login, me, etc.)
VITE_API_BASE_URL=http://localhost:8000/api

# Master switch: while Person 1 is still building crops/surveys/reports,
# leave this "true" so those screens run on mock data. Auth always uses
# the real backend regardless of this flag — see src/api/config.js.
VITE_USE_MOCK_DATA=true
