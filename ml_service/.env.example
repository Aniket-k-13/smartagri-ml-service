# Copy this file to .env for local dev, or set these as Secrets in your
# Hugging Face Space settings panel (Settings → Variables and secrets).
# Never commit real values to version control.

# Get a free key at https://openweathermap.org/api → "One Call API 3.0" or
# the free "Current weather and forecasts" plan is enough for /forecast endpoint.
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Any strong random string. The Django backend must send this exact value
# in the X-API-Key request header on every call to /predict.
API_SECRET_KEY=your_secret_api_key_here
